# Copy to .env.local for local development. Every variable is optional:
# with nothing set, the app runs fully in demo mode.

# Public URL of the deployment, used for metadata and Open Graph tags.
# Optional on Vercel, which sets the production URL automatically.
NEXT_PUBLIC_SITE_URL=

# Smart Return Assistant — set to use Claude for extraction instead of the
# built-in rule-based demo parser. Never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional model override for the assistant (defaults to claude-opus-5).
ANTHROPIC_MODEL=

# Optional founder links shown on the About page.
NEXT_PUBLIC_FOUNDER_LINKEDIN_URL=

# Public GitHub repository, linked from the footer and About page.
NEXT_PUBLIC_REPO_URL=https://github.com/DisaleGita/Return-Done

# Confirmation emails. Every booking requires an email address, and the customer gets a
# "your return is scheduled" email marked clearly as a TEST email from a demo
# website. Fill in the four SMTP values below and emails start sending.
#
# Easiest option, Gmail (no domain needed):
#   1. Turn on 2-Step Verification for your Google account
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#      SMTP_USER=your Gmail address  SMTP_PASS=the 16-character app password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender name/address. With Gmail, use your own Gmail address.
EMAIL_FROM="Return Done (demo)" <you@gmail.com>

# Optional. Leave empty to email anyone who books, or limit it, e.g.
# "you@gmail.com,@yourcompany.com".
EMAIL_ALLOWED_RECIPIENTS=

# Optional override: off | smtp | test. "test" sends to a fake Ethereal inbox
# instead of real mailboxes (handy for development).
EMAIL_MODE=

# Caps on real emails, for a public demo. Built in: 50 different people, and
# 3 emails per address. After that, bookings still work but no email is sent.
# Override here; EMAIL_MAX_RECIPIENTS=0 turns the cap off.
# Counting uses Upstash Redis on Vercel (Storage tab → Upstash for Redis);
# Vercel adds the <PREFIX>_REST_API_URL / _TOKEN variables, any prefix works.
# Locally an in-memory counter is used. Addresses are stored as hashes only.
EMAIL_MAX_RECIPIENTS=
EMAIL_MAX_PER_RECIPIENT=
